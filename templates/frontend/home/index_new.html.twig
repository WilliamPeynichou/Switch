{% extends 'base.html.twig' %}

{% block title %}Switch Game - Plateforme Sportive{% endblock %}

{% block body %}
<div class="game-history-page">
    <!-- Hero Section -->
    <div class="history-header">
        <h1>🏀 SWITCH GAME</h1>
        <p>L'expérience sportive qui révolutionne l'expérience compétitive</p>
        <div class="auth-links">
            <a href="{{ path('app_tour_du_monde') }}" class="btn btn-primary">
                🎮 Jouer au Tour du Monde
            </a>
            <a href="#games" class="btn btn-secondary">
                📋 Voir tous les jeux
            </a>
        </div>
    </div>

    <!-- Games Section -->
    <div class="stats-section">
        <h2>🎮 Nos Jeux</h2>
        
        <div class="rules-grid">
            {% for game in games %}
                <div class="rule-card">
                    <h3>{{ game.name }}</h3>
                    <p>{{ game.description|default('Un jeu de basketball passionnant avec des règles uniques.') }}</p>
                    
                    <div class="history-details">
                        <div class="detail-item">
                            <span class="detail-label">Joueurs:</span>
                            <span class="detail-value">{{ game.minPlayers|default(2) }}-{{ game.maxPlayers|default(8) }}</span>
                        </div>
                        <div class="detail-item">
                            <span class="detail-label">Durée:</span>
                            <span class="detail-value">{{ game.defaultDurationMinutes|default(30) }}min</span>
                        </div>
                    </div>
                    
                    <div class="history-actions">
                        <a href="{{ path('app_game_show', {id: game.id}) }}" class="btn btn-secondary">
                            👁️ Détails
                        </a>
                        {% if game.name == 'Tour du Monde' %}
                            <a href="{{ path('app_tour_du_monde') }}" class="btn btn-primary">
                                🎮 Jouer
                            </a>
                        {% else %}
                            <button class="btn btn-secondary" disabled>
                                ⏳ Bientôt
                            </button>
                        {% endif %}
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Features Section -->
    <div class="history-section">
        <h2>✨ Fonctionnalités</h2>
        
        <div class="rules-grid">
            <div class="rule-card">
                <h3>🎯 Jeux Personnalisés</h3>
                <p>Créez vos propres règles et défis pour des parties uniques et mémorables.</p>
            </div>
            
            <div class="rule-card">
                <h3>📊 Statistiques</h3>
                <p>Suivez vos performances et progressez avec des statistiques détaillées.</p>
            </div>
            
            <div class="rule-card">
                <h3>👥 Multijoueur</h3>
                <p>Jouez avec vos amis et organisez des tournois épiques.</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
