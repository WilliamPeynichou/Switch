{% extends 'base.html.twig' %}

{% block title %}{{ game.name }} - Switch Game{% endblock %}

{% block body %}
<div class="game-hero">
    <div class="container">
        <div class="hero-content">
            <h1 class="game-title">
                <span class="title-icon">🏀</span>
                {{ game.name }}
            </h1>
            <p class="game-subtitle">{{ game.description ?? 'Jeu de basket passionnant' }}</p>
        </div>
    </div>
</div>

<div class="game-content">
    <div class="container">
        {% if message is defined %}
            <div class="development-notice">
                <div class="notice-card">
                    <h2>🚧 Page en cours de développement</h2>
                    <p>{{ message }}</p>
                    <p>Cette page sera bientôt disponible avec toutes les fonctionnalités du jeu !</p>
                    <a href="{{ path('app_home') }}" class="btn btn-primary">
                        <i class="icon">🏠</i>
                        Retour à l'accueil
                    </a>
                </div>
            </div>
        {% else %}
            <div class="game-info">
                <h2>Informations du jeu</h2>
                <div class="info-grid">
                    <div class="info-card">
                        <h3>Description</h3>
                        <p>{{ game.description ?? 'Aucune description disponible' }}</p>
                    </div>
                    
                    <div class="info-card">
                        <h3>Type de jeu</h3>
                        <p>{{ game.gameType ?? 'Non spécifié' }}</p>
                    </div>
                    
                    <div class="info-card">
                        <h3>Nombre de joueurs</h3>
                        <p>{{ game.minPlayers ?? 1 }} - {{ game.maxPlayers ?? 10 }} joueurs</p>
                    </div>
                    
                    <div class="info-card">
                        <h3>Durée moyenne</h3>
                        <p>{{ game.defaultDurationMinutes ?? 30 }} minutes</p>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
.game-hero {
    background: linear-gradient(135deg, var(--vintage-orange) 0%, #F7931E 100%);
    color: white;
    padding: 4rem 0;
    text-align: center;
}

.game-title {
    font-size: 3.5rem;
    font-weight: bold;
    margin: 0;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.title-icon {
    font-size: 4rem;
    margin-right: 1rem;
}

.game-subtitle {
    font-size: 1.3rem;
    margin: 1rem 0 0 0;
    opacity: 0.9;
}

.game-content {
    padding: 4rem 0;
    background: #f8f9fa;
}

.development-notice {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
}

.notice-card {
    background: white;
    padding: 3rem;
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
}

.notice-card h2 {
    color: var(--vintage-orange);
    margin-bottom: 1rem;
}

.notice-card p {
    color: #666;
    margin-bottom: 1rem;
}

.game-info {
    background: white;
    padding: 3rem;
    border-radius: 20px;
    box-shadow: 0 15px 40px rgba(0,0,0,0.1);
}

.info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.info-card {
    background: #f8f9fa;
    padding: 2rem;
    border-radius: 15px;
    border-left: 4px solid var(--vintage-orange);
}

.info-card h3 {
    color: var(--vintage-orange);
    margin-bottom: 1rem;
}

.info-card p {
    color: #666;
    margin: 0;
}

/* Responsive */
@media (max-width: 768px) {
    .game-title {
        font-size: 2.5rem;
    }
    
    .info-grid {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}