{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Switch Game{% endblock %}

{% block body %}
<div class="profile-hero">
    <div class="container">
        <div class="profile-header">
            <div class="profile-avatar">
                <div class="avatar-circle">
                    <span class="avatar-text">{{ (app.user.firstName|first ~ app.user.lastName|first)|upper }}</span>
                </div>
            </div>
            <div class="profile-info">
                <h1 class="profile-name">{{ app.user.firstName }} {{ app.user.lastName }}</h1>
                <p class="profile-username">@{{ app.user.username }}</p>
                <p class="profile-email">{{ app.user.email }}</p>
                <div class="profile-stats">
                    <div class="stat-item">
                        <span class="stat-value">{{ app.user.gameSessions|length }}</span>
                        <span class="stat-label">Sessions</span>
                    </div>
                    <div class="stat-item">
                        <span class="stat-value">{{ app.user.sessionParticipants|length }}</span>
                        <span class="stat-label">Participations</span>
                    </div>
                </div>
            </div>
            <div class="profile-actions">
                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                    <i class="icon">✏️</i>
                    Modifier le profil
                </a>
            </div>
        </div>
    </div>
</div>

<div class="profile-content">
    <div class="container">
        <div class="profile-grid">
            <div class="profile-section">
                <h2 class="section-title">
                    <i class="icon">📊</i>
                    Mes Statistiques
                </h2>
                <div class="stats-grid">
                    <div class="stat-card">
                        <div class="stat-icon">🎮</div>
                        <div class="stat-content">
                            <h3>{{ app.user.gameSessions|length }}</h3>
                            <p>Sessions créées</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">👥</div>
                        <div class="stat-content">
                            <h3>{{ app.user.sessionParticipants|length }}</h3>
                            <p>Participations</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">🏆</div>
                        <div class="stat-content">
                            <h3>0</h3>
                            <p>Victoires</p>
                        </div>
                    </div>
                    <div class="stat-card">
                        <div class="stat-icon">⭐</div>
                        <div class="stat-content">
                            <h3>0</h3>
                            <p>Points totaux</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="profile-section">
                <h2 class="section-title">
                    <i class="icon">🎯</i>
                    Mes Sessions Récentes
                </h2>
                {% if app.user.gameSessions|length > 0 %}
                    <div class="sessions-list">
                        {% for session in app.user.gameSessions|slice(0, 5) %}
                        <div class="session-card">
                            <div class="session-info">
                                <h3>{{ session.sessionName }}</h3>
                                <p class="session-game">{{ session.game.name }}</p>
                                <p class="session-date">{{ session.createdAt|date('d/m/Y H:i') }}</p>
                            </div>
                            <div class="session-status">
                                <span class="status-badge status-{{ session.status }}">
                                    {{ session.status|title }}
                                </span>
                            </div>
                            <div class="session-actions">
                                <a href="{{ path('app_session_show', {id: session.id}) }}" class="btn btn-sm btn-primary">
                                    Voir détails
                                </a>
                            </div>
                        </div>
                        {% endfor %}
                    </div>
                    <div class="text-center">
                        <a href="{{ path('app_statistics_my_sessions') }}" class="btn btn-secondary">
                            Voir toutes mes sessions
                        </a>
                    </div>
                {% else %}
                    <div class="empty-state">
                        <div class="empty-icon">🎮</div>
                        <h3>Aucune session</h3>
                        <p>Commencez à jouer pour voir vos sessions !</p>
                        <a href="{{ path('app_home') }}" class="btn btn-primary">Découvrir les jeux</a>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
.profile-hero {
    background: linear-gradient(135deg, var(--vintage-orange) 0%, var(--vintage-orange-dark) 100%);
    color: white;
    padding: var(--space-3xl) 0;
    position: relative;
    overflow: hidden;
}

.profile-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.3;
}

.profile-header {
    display: flex;
    align-items: center;
    gap: var(--space-2xl);
    position: relative;
    z-index: 1;
}

.profile-avatar {
    flex-shrink: 0;
}

.avatar-circle {
    width: 120px;
    height: 120px;
    border-radius: var(--radius-full);
    background: rgba(255, 255, 255, 0.2);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 4px solid rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(10px);
}

.avatar-text {
    font-size: var(--text-4xl);
    font-weight: 900;
    color: white;
}

.profile-info {
    flex: 1;
}

.profile-name {
    font-size: var(--text-4xl);
    font-weight: 900;
    margin: 0 0 var(--space-sm) 0;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.profile-username {
    font-size: var(--text-lg);
    margin: 0 0 var(--space-xs) 0;
    opacity: 0.9;
}

.profile-email {
    font-size: var(--text-base);
    margin: 0 0 var(--space-lg) 0;
    opacity: 0.8;
}

.profile-stats {
    display: flex;
    gap: var(--space-xl);
}

.stat-item {
    text-align: center;
}

.stat-value {
    display: block;
    font-size: var(--text-2xl);
    font-weight: 700;
    margin-bottom: var(--space-xs);
}

.stat-label {
    font-size: var(--text-sm);
    opacity: 0.8;
}

.profile-actions {
    flex-shrink: 0;
}

.profile-content {
    padding: var(--space-3xl) 0;
    background: #f8f9fa;
}

.profile-grid {
    display: grid;
    gap: var(--space-3xl);
}

.profile-section {
    background: white;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-2xl);
}

.section-title {
    font-size: var(--text-2xl);
    font-weight: 700;
    color: var(--vintage-blue);
    margin-bottom: var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--space-lg);
}

.stat-card {
    background: #f8f9fa;
    padding: var(--space-xl);
    border-radius: var(--radius-xl);
    text-align: center;
    transition: var(--transition-normal);
    border: 1px solid #e9ecef;
}

.stat-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-md);
}

.stat-icon {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-md);
    display: block;
}

.stat-content h3 {
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--vintage-orange);
    margin: 0 0 var(--space-sm) 0;
}

.stat-content p {
    color: var(--vintage-gray);
    margin: 0;
    font-weight: 500;
}

.sessions-list {
    display: grid;
    gap: var(--space-lg);
}

.session-card {
    background: #f8f9fa;
    padding: var(--space-lg);
    border-radius: var(--radius-xl);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-lg);
    transition: var(--transition-normal);
    border: 1px solid #e9ecef;
}

.session-card:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
}

.session-info h3 {
    margin: 0 0 var(--space-xs) 0;
    color: var(--vintage-blue);
    font-size: var(--text-lg);
}

.session-game {
    color: var(--vintage-gray);
    margin: 0 0 var(--space-xs) 0;
    font-size: var(--text-sm);
}

.session-date {
    color: var(--vintage-gray-dark);
    margin: 0;
    font-size: var(--text-xs);
}

.status-badge {
    padding: var(--space-xs) var(--space-sm);
    border-radius: var(--radius-full);
    font-size: var(--text-xs);
    font-weight: 600;
    text-transform: uppercase;
}

.status-active { background: #d4edda; color: #155724; }
.status-paused { background: #fff3cd; color: #856404; }
.status-completed { background: #cce5ff; color: #004085; }

.empty-state {
    text-align: center;
    padding: var(--space-3xl);
    background: #f8f9fa;
    border-radius: var(--radius-xl);
    border: 2px dashed #e9ecef;
}

.empty-icon {
    font-size: var(--text-6xl);
    margin-bottom: var(--space-lg);
}

.empty-state h3 {
    color: var(--vintage-blue);
    margin-bottom: var(--space-sm);
    font-size: var(--text-xl);
}

.empty-state p {
    color: var(--vintage-gray);
    margin-bottom: var(--space-xl);
}

/* Responsive */
@media (max-width: 1023px) {
    .profile-header {
        flex-direction: column;
        text-align: center;
        gap: var(--space-xl);
    }
    
    .profile-stats {
        justify-content: center;
    }
}

@media (max-width: 767px) {
    .profile-hero {
        padding: var(--space-2xl) 0;
    }
    
    .profile-header {
        padding: 0 var(--space-lg);
    }
    
    .avatar-circle {
        width: 100px;
        height: 100px;
    }
    
    .avatar-text {
        font-size: var(--text-3xl);
    }
    
    .profile-name {
        font-size: var(--text-3xl);
    }
    
    .profile-stats {
        flex-direction: column;
        gap: var(--space-lg);
    }
    
    .profile-content {
        padding: var(--space-2xl) 0;
    }
    
    .profile-section {
        padding: var(--space-xl);
        margin: 0 var(--space-lg);
    }
    
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: var(--space-md);
    }
    
    .session-card {
        flex-direction: column;
        text-align: center;
        gap: var(--space-md);
    }
}

@media (max-width: 480px) {
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .profile-section {
        margin: 0 var(--space-sm);
    }
}
</style>
{% endblock %}
