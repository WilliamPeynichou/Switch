{% extends 'base.html.twig' %}

{% block title %}Nouveau mot de passe - Switch Game{% endblock %}

{% block body %}
<div class="game-history-page">
    <!-- Hero Section -->
    <div class="history-header">
        <h1>🔐 Nouveau mot de passe</h1>
        <p>Choisissez un nouveau mot de passe sécurisé</p>
    </div>

    <!-- Reset Password Form -->
    <div class="stats-section">
        <h2>🔑 Définir un nouveau mot de passe</h2>
        
        <form method="POST" class="reset-password-form">
            <div class="input-group">
                <label for="password">Nouveau mot de passe *</label>
                <input type="password" name="password" id="password" class="form-control" required
                       placeholder="Minimum 6 caractères">
            </div>

            <div class="input-group">
                <label for="confirm_password">Confirmer le mot de passe *</label>
                <input type="password" name="confirm_password" id="confirm_password" class="form-control" required
                       placeholder="Répétez le mot de passe">
            </div>

            <div class="history-actions">
                <button type="submit" class="btn btn-primary">
                    🔑 Réinitialiser le mot de passe
                </button>
                <a href="{{ path('app_login') }}" class="btn btn-secondary">
                    ↩️ Retour à la connexion
                </a>
            </div>
        </form>
    </div>

    <!-- Security Tips -->
    <div class="history-section">
        <h2>🛡️ Conseils de sécurité</h2>
        
        <div class="rules-grid">
            <div class="rule-card">
                <h3>🔤 Utilisez des caractères variés</h3>
                <p>Majuscules, minuscules, chiffres et symboles</p>
            </div>
            
            <div class="rule-card">
                <h3>📏 Au moins 8 caractères</h3>
                <p>Plus c'est long, plus c'est sécurisé</p>
            </div>
            
            <div class="rule-card">
                <h3>🚫 Évitez les mots courants</h3>
                <p>Pas de mots du dictionnaire ou d'informations personnelles</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
