{% extends 'base.html.twig' %}

{% block title %}Mon Profil - Switch Game{% endblock %}

{% block body %}
<div class="game-history-page">
    <!-- Hero Section -->
    <div class="history-header">
        <h1>👤 Mon Profil</h1>
        <p>Gérez vos informations et suivez vos performances</p>
    </div>

    <!-- Profile Info -->
    <div class="stats-section">
        <h2>📋 Informations Personnelles</h2>
        
        <div class="history-item">
            <div class="history-header">
                <div class="history-title">
                    <h3>{{ app.user.firstName }} {{ app.user.lastName }}</h3>
                </div>
                <div class="history-date">
                    @{{ app.user.username }}
                </div>
            </div>
            
            <div class="history-details">
                <div class="detail-item">
                    <span class="detail-label">Email:</span>
                    <span class="detail-value">{{ app.user.email }}</span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Membre depuis:</span>
                    <span class="detail-value">{{ app.user.createdAt|date('d/m/Y') }}</span>
                </div>
            </div>
            
            <div class="history-actions">
                <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
                    ✏️ Modifier le profil
                </a>
            </div>
        </div>
    </div>

    <!-- Statistics -->
    <div class="history-section">
        <h2>📊 Mes Statistiques</h2>
        
        <div class="rules-grid">
            <div class="rule-card">
                <h3>🎮 Sessions Créées</h3>
                <div class="detail-value">{{ app.user.gameSessions|length }}</div>
            </div>
            
            <div class="rule-card">
                <h3>👥 Participations</h3>
                <div class="detail-value">{{ app.user.sessionParticipants|length }}</div>
            </div>
            
            <div class="rule-card">
                <h3>🏆 Victoires</h3>
                <div class="detail-value">0</div>
            </div>
            
            <div class="rule-card">
                <h3>⭐ Points Totaux</h3>
                <div class="detail-value">0</div>
            </div>
        </div>
    </div>

    <!-- Actions -->
    <div class="history-actions">
        <a href="{{ path('app_profile_edit') }}" class="btn btn-primary">
            ✏️ Modifier le profil
        </a>
        <a href="{{ path('app_statistics_index') }}" class="btn btn-secondary">
            📊 Voir les statistiques
        </a>
        <a href="{{ path('app_home') }}" class="btn btn-secondary">
            🏠 Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}