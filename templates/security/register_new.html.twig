{% extends 'base.html.twig' %}

{% block title %}Inscription - Switch Game{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="container">
        <div class="card">
            <div class="auth-header">
                <h1 class="auth-title">Inscription</h1>
                <p class="auth-subtitle">Créez votre compte Switch Game</p>
            </div>

            <form method="post" class="auth-form">
                <div class="form-group">
                    <label for="registration_form_email" class="form-label">Email</label>
                    <input type="email" 
                           name="registration_form[email]" 
                           id="registration_form_email" 
                           class="form-control" 
                           autocomplete="email" 
                           required 
                           autofocus>
                </div>
                
                <div class="form-group">
                    <label for="registration_form_username" class="form-label">Nom d'utilisateur</label>
                    <input type="text" 
                           name="registration_form[username]" 
                           id="registration_form_username" 
                           class="form-control" 
                           autocomplete="username" 
                           required>
                </div>
                
                <div class="form-group">
                    <label for="registration_form_firstName" class="form-label">Prénom</label>
                    <input type="text" 
                           name="registration_form[firstName]" 
                           id="registration_form_firstName" 
                           class="form-control" 
                           autocomplete="given-name" 
                           required>
                </div>
                
                <div class="form-group">
                    <label for="registration_form_lastName" class="form-label">Nom</label>
                    <input type="text" 
                           name="registration_form[lastName]" 
                           id="registration_form_lastName" 
                           class="form-control" 
                           autocomplete="family-name" 
                           required>
                </div>
                
                <div class="form-group">
                    <label for="registration_form_plainPassword" class="form-label">Mot de passe</label>
                    <input type="password" 
                           name="registration_form[plainPassword]" 
                           id="registration_form_plainPassword" 
                           class="form-control" 
                           autocomplete="new-password" 
                           required>
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary btn-full">
                        Créer mon compte
                    </button>
                </div>
            </form>

            <div class="auth-footer">
                <p>Déjà un compte ? <a href="{{ path('app_login') }}" class="auth-link">Se connecter</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
