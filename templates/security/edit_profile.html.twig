{% extends 'base.html.twig' %}

{% block title %}Modifier le Profil - Switch Game{% endblock %}

{% block body %}
<div class="profile-edit-hero">
    <div class="container">
        <div class="profile-edit-header">
            <h1 class="page-title">
                <span class="title-icon">✏️</span>
                Modifier le Profil
            </h1>
            <p class="page-subtitle">Mettez à jour vos informations personnelles</p>
        </div>
    </div>
</div>

<div class="profile-edit-content">
    <div class="container">
        <div class="profile-edit-card">
            {{ form_start(form, {'attr': {'class': 'profile-edit-form'}}) }}
                <div class="form-section">
                    <h3 class="section-title">
                        <i class="icon">👤</i>
                        Informations personnelles
                    </h3>
                    
                    <div class="form-row">
                        <div class="form-group">
                            {{ form_label(form.firstName, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.firstName, {'attr': {'class': 'form-input', 'placeholder': 'Votre prénom'}}) }}
                            {{ form_errors(form.firstName) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.lastName, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.lastName, {'attr': {'class': 'form-input', 'placeholder': 'Votre nom'}}) }}
                            {{ form_errors(form.lastName) }}
                        </div>
                    </div>

                    <div class="form-row">
                        <div class="form-group">
                            {{ form_label(form.username, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.username, {'attr': {'class': 'form-input', 'placeholder': 'Votre nom d\'utilisateur'}}) }}
                            {{ form_errors(form.username) }}
                        </div>
                        <div class="form-group">
                            {{ form_label(form.email, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.email, {'attr': {'class': 'form-input', 'placeholder': 'votre@email.com'}}) }}
                            {{ form_errors(form.email) }}
                        </div>
                    </div>
                </div>

                <div class="form-section">
                    <h3 class="section-title">
                        <i class="icon">🔒</i>
                        Sécurité
                    </h3>
                    
                    <div class="form-group">
                        {{ form_label(form.plainPassword.first, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-input', 'placeholder': 'Nouveau mot de passe (optionnel)'}}) }}
                        {{ form_errors(form.plainPassword.first) }}
                    </div>
                    
                    <div class="form-group">
                        {{ form_label(form.plainPassword.second, null, {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-input', 'placeholder': 'Confirmez le nouveau mot de passe'}}) }}
                        {{ form_errors(form.plainPassword.second) }}
                    </div>
                    
                    <div class="form-help">
                        <i class="icon">💡</i>
                        <p>Laissez les champs de mot de passe vides si vous ne souhaitez pas le changer.</p>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="{{ path('app_profile') }}" class="btn btn-secondary">
                        <i class="icon">↩️</i>
                        Annuler
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="icon">💾</i>
                        Sauvegarder les modifications
                    </button>
                </div>
            {{ form_end(form) }}
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
.profile-edit-hero {
    background: linear-gradient(135deg, var(--vintage-orange) 0%, var(--vintage-orange-dark) 100%);
    color: white;
    padding: var(--space-3xl) 0;
    text-align: center;
    position: relative;
    overflow: hidden;
}

.profile-edit-hero::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="25" cy="25" r="1" fill="white" opacity="0.1"/><circle cx="75" cy="75" r="1" fill="white" opacity="0.1"/><circle cx="50" cy="10" r="0.5" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
    opacity: 0.3;
}

.profile-edit-header {
    position: relative;
    z-index: 1;
}

.page-title {
    font-size: clamp(var(--text-3xl), 4vw, var(--text-5xl));
    font-weight: 900;
    margin: 0 0 var(--space-lg) 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-lg);
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}

.title-icon {
    font-size: clamp(var(--text-4xl), 5vw, var(--text-6xl));
}

.page-subtitle {
    font-size: var(--text-lg);
    margin: 0;
    opacity: 0.9;
}

.profile-edit-content {
    padding: var(--space-3xl) 0;
    background: #f8f9fa;
}

.profile-edit-card {
    background: white;
    border-radius: var(--radius-2xl);
    box-shadow: var(--shadow-xl);
    padding: var(--space-3xl);
    max-width: 800px;
    margin: 0 auto;
    animation: fadeInUp 0.6s ease-out;
}

.profile-edit-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-3xl);
}

.form-section {
    border-bottom: 1px solid #e9ecef;
    padding-bottom: var(--space-2xl);
}

.form-section:last-of-type {
    border-bottom: none;
    padding-bottom: 0;
}

.section-title {
    font-size: var(--text-xl);
    font-weight: 700;
    color: var(--vintage-blue);
    margin-bottom: var(--space-xl);
    display: flex;
    align-items: center;
    gap: var(--space-sm);
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-lg);
    margin-bottom: var(--space-lg);
}

.form-group {
    display: flex;
    flex-direction: column;
}

.form-label {
    margin-bottom: var(--space-sm);
    font-weight: 600;
    color: var(--vintage-blue);
    font-size: var(--text-sm);
}

.form-input {
    padding: var(--space-lg);
    border: 2px solid #e9ecef;
    border-radius: var(--radius-lg);
    font-size: var(--text-base);
    transition: var(--transition-fast);
    background: white;
    box-sizing: border-box;
}

.form-input:focus {
    outline: none;
    border-color: var(--vintage-orange);
    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.1);
    transform: translateY(-2px);
}

.form-input:hover {
    border-color: var(--vintage-orange-light);
}

.form-help {
    background: #f8f9fa;
    border: 1px solid #e9ecef;
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    margin-top: var(--space-lg);
}

.form-help .icon {
    color: var(--vintage-orange);
    font-size: var(--text-lg);
    margin-top: 2px;
}

.form-help p {
    margin: 0;
    color: var(--vintage-gray);
    font-size: var(--text-sm);
    line-height: 1.5;
}

.form-actions {
    display: flex;
    gap: var(--space-lg);
    justify-content: flex-end;
    padding-top: var(--space-xl);
    border-top: 1px solid #e9ecef;
}

.btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-sm);
    padding: var(--space-lg) var(--space-xl);
    border: none;
    border-radius: var(--radius-lg);
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition: var(--transition-fast);
    font-size: var(--text-base);
    min-height: 48px;
}

.btn-primary {
    background: var(--vintage-orange);
    color: white;
    box-shadow: var(--shadow-md);
}

.btn-primary:hover {
    background: var(--vintage-orange-dark);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

.btn-secondary {
    background: #6c757d;
    color: white;
    box-shadow: var(--shadow-md);
}

.btn-secondary:hover {
    background: #5a6268;
    transform: translateY(-2px);
    box-shadow: var(--shadow-lg);
}

/* Responsive */
@media (max-width: 767px) {
    .profile-edit-hero {
        padding: var(--space-2xl) 0;
    }
    
    .profile-edit-content {
        padding: var(--space-2xl) 0;
    }
    
    .profile-edit-card {
        padding: var(--space-2xl);
        margin: 0 var(--space-lg);
    }
    
    .form-row {
        grid-template-columns: 1fr;
        gap: var(--space-md);
    }
    
    .form-actions {
        flex-direction: column;
        gap: var(--space-md);
    }
    
    .btn {
        width: 100%;
    }
    
    .form-input {
        font-size: 16px; /* Prevent zoom on iOS */
    }
}

@media (max-width: 480px) {
    .profile-edit-card {
        margin: 0 var(--space-sm);
        padding: var(--space-xl);
    }
    
    .page-title {
        flex-direction: column;
        gap: var(--space-sm);
    }
}

/* Animations */
@keyframes fadeInUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
</style>
{% endblock %}
