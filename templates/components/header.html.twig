<!-- Header Component - Sport Design -->
<header>
    <div class="navbar">
        <!-- Logo -->
        <a href="{{ path('app_home') }}" class="navbar-brand">
            🏀 SWITCH GAME
        </a>
        
        <!-- Navigation -->
        <nav>
            <ul class="navbar-nav">
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                {% if app.user %}
                {% endif %}
            </ul>
        </nav>
        
        <!-- User Menu / Auth -->
        <div class="nav-auth">
            {% if app.user %}
                <div class="user-menu">
                    <button class="user-menu-toggle">
                        <span>{{ app.user.firstName ?? app.user.username }}</span>
                        <span>▼</span>
                    </button>
                    <div class="dropdown-menu">
                        <a href="{{ path('app_profile') }}">👤 Mon profil</a>
                        <a href="{{ path('app_profile_edit') }}">⚙️ Modifier profil</a>
                        <a href="{{ path('app_statistics_index') }}">📊 Mes statistiques</a>
                        <a href="{{ path('app_tour_du_monde_history') }}">🎮 Historique Tour du Monde</a>
                        <div class="dropdown-divider"></div>
                        <a href="{{ path('app_logout') }}" class="logout">🚪 Déconnexion</a>
                    </div>
                </div>
            {% else %}
                <div class="auth-links">
                    <a href="{{ path('app_login') }}" class="btn btn-secondary">Connexion</a>
                    <a href="{{ path('app_register') }}" class="btn btn-primary">Inscription</a>
                </div>
            {% endif %}
        </div>
    </div>
</header>
