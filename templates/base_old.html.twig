<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/responsive.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/components.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/animations.css') }}">
            <link rel="stylesheet" href="{{ asset('styles/utilities.css') }}">
        {% endblock %}
                :root {
                    --vintage-orange: #FF6B35;
                    --vintage-red: #D32F2F;
                    --vintage-blue: #1976D2;
                    --vintage-yellow: #FFD700;
                    --vintage-brown: #8D6E63;
                    --vintage-cream: #FFF8E1;
                    --vintage-dark: #2C1810;
                    --vintage-light: #F5F5DC;
                    --vintage-gold: #B8860B;
                }
                
                * {
                    margin: 0;
                    padding: 0;
                    box-sizing: border-box;
                }
                
                body {
                    font-family: 'Arial Black', Arial, sans-serif;
                    background: linear-gradient(135deg, var(--vintage-cream) 0%, var(--vintage-light) 100%);
                    color: var(--vintage-dark);
                    line-height: 1.6;
                    overflow-x: hidden;
                }
                
                .container {
                    max-width: 1200px;
                    margin: 0 auto;
                    padding: 0 20px;
                }
                
                .header {
                    background: var(--vintage-dark);
                    padding: 1rem 0;
                    border-bottom: 4px solid var(--vintage-orange);
                    position: sticky;
                    top: 0;
                    z-index: 1000;
                }
                
        .header-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        
        .nav-auth {
            display: flex;
            align-items: center;
            gap: 1rem;
        }
        
        .auth-links {
            display: flex;
            gap: 0.5rem;
        }
        
        .user-menu {
            position: relative;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        
        .user-greeting {
            color: var(--vintage-orange);
            font-weight: bold;
            cursor: pointer;
        }
        
        .user-dropdown {
            position: absolute;
            top: 100%;
            right: 0;
            background: white;
            border-radius: 10px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            padding: 0.5rem 0;
            min-width: 150px;
            display: none;
            z-index: 1000;
        }
        
        .user-menu:hover .user-dropdown {
            display: block;
        }
        
        .dropdown-link {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.75rem 1rem;
            color: #333;
            text-decoration: none;
            transition: background 0.3s ease;
        }
        
        .dropdown-link:hover {
            background: #f8f9fa;
        }
        
        .btn-outline {
            background: transparent;
            color: var(--vintage-orange);
            border: 2px solid var(--vintage-orange);
            padding: 0.5rem 1rem;
            border-radius: 8px;
            text-decoration: none;
            font-weight: bold;
            transition: all 0.3s ease;
        }
        
        .btn-outline:hover {
            background: var(--vintage-orange);
            color: white;
        }
                
                .logo {
                    font-size: 2rem;
                    font-weight: 900;
                    color: var(--vintage-orange);
                    text-decoration: none;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                    text-shadow: 2px 2px 0px var(--vintage-dark);
                }
                
                .nav-menu {
                    display: flex;
                    list-style: none;
                    gap: 2rem;
                }
                
                .nav-menu a {
                    color: var(--vintage-light);
                    text-decoration: none;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                    padding: 0.5rem 1rem;
                    border: 2px solid transparent;
                    transition: all 0.3s ease;
                }
                
                .nav-menu a:hover {
                    color: var(--vintage-orange);
                    border-color: var(--vintage-orange);
                    background: var(--vintage-dark);
                }
                
                .footer {
                    background: var(--vintage-dark);
                    color: var(--vintage-light);
                    padding: 2rem 0;
                    border-top: 4px solid var(--vintage-blue);
                    margin-top: 4rem;
                }
                
                .footer-content {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                    gap: 2rem;
                    margin-bottom: 2rem;
                }
                
                .footer-section h3 {
                    color: var(--vintage-orange);
                    margin-bottom: 1rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }
                
                .footer-section p,
                .footer-section a {
                    color: var(--vintage-light);
                    text-decoration: none;
                    line-height: 1.6;
                }
                
                .footer-section a:hover {
                    color: var(--vintage-orange);
                }
                
                .footer-bottom {
                    text-align: center;
                    padding-top: 2rem;
                    border-top: 1px solid var(--vintage-brown);
                    color: var(--vintage-brown);
                }
                
                .hero-section {
                    min-height: 80vh;
                    display: flex;
                    align-items: center;
                    background: 
                        radial-gradient(circle at 20% 80%, var(--vintage-orange) 0%, transparent 50%),
                        radial-gradient(circle at 80% 20%, var(--vintage-blue) 0%, transparent 50%),
                        linear-gradient(135deg, var(--vintage-cream) 0%, var(--vintage-light) 100%);
                    position: relative;
                    overflow: hidden;
                }
                
                .hero-content {
                    text-align: center;
                    position: relative;
                    z-index: 2;
                }
                
                .hero-title {
                    font-size: 4.5rem;
                    font-weight: 900;
                    margin-bottom: 1rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                    line-height: 1.1;
                }
                
                .vintage-text {
                    display: block;
                    color: var(--vintage-orange);
                    text-shadow: 3px 3px 0px var(--vintage-dark);
                    transform: rotate(-2deg);
                    animation: vintageGlow 2s ease-in-out infinite alternate;
                }
                
                .sport-text {
                    display: block;
                    color: var(--vintage-blue);
                    text-shadow: 3px 3px 0px var(--vintage-dark);
                    transform: rotate(1deg);
                    animation: sportPulse 2s ease-in-out infinite alternate;
                }
                
                @keyframes vintageGlow {
                    0% { text-shadow: 3px 3px 0px var(--vintage-dark), 0 0 20px var(--vintage-orange); }
                    100% { text-shadow: 3px 3px 0px var(--vintage-dark), 0 0 30px var(--vintage-orange); }
                }
                
                @keyframes sportPulse {
                    0% { text-shadow: 3px 3px 0px var(--vintage-dark), 0 0 20px var(--vintage-blue); }
                    100% { text-shadow: 3px 3px 0px var(--vintage-dark), 0 0 30px var(--vintage-blue); }
                }
                
                .hero-subtitle {
                    font-size: 1.5rem;
                    color: var(--vintage-brown);
                    margin-bottom: 2rem;
                    font-weight: 600;
                    text-shadow: 1px 1px 2px rgba(0,0,0,0.1);
                }
                
                .hero-buttons {
                    display: flex;
                    gap: 1rem;
                    justify-content: center;
                    flex-wrap: wrap;
                }
                
                .btn {
                    padding: 15px 30px;
                    font-size: 1.1rem;
                    font-weight: bold;
                    text-transform: uppercase;
                    text-decoration: none;
                    border: 3px solid;
                    border-radius: 0;
                    transition: all 0.3s ease;
                    position: relative;
                    overflow: hidden;
                    letter-spacing: 0.1em;
                }
                
                .btn-primary {
                    background: var(--vintage-orange);
                    color: white;
                    border-color: var(--vintage-dark);
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                }
                
                .btn-primary:hover {
                    background: var(--vintage-red);
                    transform: translate(-2px, -2px);
                    box-shadow: 7px 7px 0px var(--vintage-dark);
                }
                
                .btn-secondary {
                    background: transparent;
                    color: var(--vintage-blue);
                    border-color: var(--vintage-blue);
                    box-shadow: 5px 5px 0px var(--vintage-blue);
                }
                
                .btn-secondary:hover {
                    background: var(--vintage-blue);
                    color: white;
                    transform: translate(-2px, -2px);
                    box-shadow: 7px 7px 0px var(--vintage-dark);
                }
                
                .features-section {
                    padding: 80px 0;
                    background: var(--vintage-light);
                    position: relative;
                }
                
                .features-section::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 4px;
                    background: linear-gradient(90deg, var(--vintage-orange), var(--vintage-blue), var(--vintage-orange));
                }
                
                .features-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                    gap: 2rem;
                    margin-top: 2rem;
                }
                
                .feature-card {
                    background: white;
                    padding: 2rem;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    text-align: center;
                    transition: all 0.3s ease;
                    position: relative;
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }
                
                .feature-card:hover {
                    transform: translate(-5px, -5px);
                    box-shadow: 13px 13px 0px var(--vintage-dark);
                }
                
                .feature-icon {
                    font-size: 3rem;
                    margin-bottom: 1rem;
                    filter: drop-shadow(2px 2px 4px rgba(0,0,0,0.3));
                }
                
                .feature-card h3 {
                    font-size: 1.5rem;
                    color: var(--vintage-dark);
                    margin-bottom: 1rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }
                
                .feature-card p {
                    color: var(--vintage-brown);
                    font-size: 1.1rem;
                    line-height: 1.5;
                }
                
                @media (max-width: 768px) {
                    .hero-title {
                        font-size: 3rem;
                    }
                    
                    .hero-subtitle {
                        font-size: 1.2rem;
                    }
                    
                    .btn {
                        padding: 12px 24px;
                        font-size: 1rem;
                    }
                    
                    .features-grid {
                        grid-template-columns: 1fr;
                    }
                    
                    .nav-menu {
                        flex-direction: column;
                        gap: 1rem;
                    }
                    
                    .header-content {
                        flex-direction: column;
                        gap: 1rem;
                    }
                }
                
                @media (max-width: 480px) {
                    .hero-title {
                        font-size: 2.5rem;
                    }
                    
                    .hero-buttons {
                        flex-direction: column;
                        align-items: center;
                    }
                }

                /* Styles pour les jeux */
                .section-title {
                    font-size: 2.5rem;
                    text-align: center;
                    margin-bottom: 3rem;
                    color: var(--vintage-dark);
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .title-icon {
                    font-size: 2rem;
                    margin-right: 1rem;
                }

                /* Section jeux populaires */
                .popular-games-section {
                    padding: 80px 0;
                    background: var(--vintage-light);
                    border-top: 4px solid var(--vintage-orange);
                }

                .popular-games-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
                    gap: 2rem;
                }

                .popular-game-card {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    transition: all 0.3s ease;
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }

                .popular-game-card:hover {
                    transform: translate(-5px, -5px);
                    box-shadow: 13px 13px 0px var(--vintage-dark);
                }

                /* Section principale des jeux */
                .games-section {
                    padding: 80px 0;
                    background: var(--vintage-cream);
                }

                /* Filtres */
                .games-filters {
                    display: flex;
                    gap: 2rem;
                    margin-bottom: 3rem;
                    justify-content: center;
                    flex-wrap: wrap;
                }

                .filter-group {
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                }

                .filter-group label {
                    font-weight: bold;
                    color: var(--vintage-dark);
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .filter-select {
                    padding: 0.75rem 1rem;
                    border: 2px solid var(--vintage-dark);
                    background: white;
                    font-size: 1rem;
                    min-width: 200px;
                    transition: all 0.3s ease;
                }

                .filter-select:focus {
                    outline: none;
                    border-color: var(--vintage-orange);
                    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.2);
                }

                /* Container de scroll */
                .games-scroll-container {
                    max-height: 70vh;
                    overflow-y: auto;
                    border: 3px solid var(--vintage-dark);
                    background: white;
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }

                .games-scroll-container::-webkit-scrollbar {
                    width: 12px;
                }

                .games-scroll-container::-webkit-scrollbar-track {
                    background: var(--vintage-light);
                }

                .games-scroll-container::-webkit-scrollbar-thumb {
                    background: var(--vintage-orange);
                    border-radius: 0;
                }

                .games-scroll-container::-webkit-scrollbar-thumb:hover {
                    background: var(--vintage-red);
                }

                /* Grille des jeux */
                .games-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
                    gap: 2rem;
                    padding: 2rem;
                }

                .game-card {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    transition: all 0.3s ease;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                }

                .game-card:hover {
                    transform: translate(-3px, -3px);
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }

                .game-header {
                    position: relative;
                    height: 200px;
                    overflow: hidden;
                }

                .game-image {
                    width: 100%;
                    height: 100%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    background: linear-gradient(135deg, var(--vintage-orange), var(--vintage-blue));
                }

                .game-image img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

                .game-placeholder {
                    font-size: 4rem;
                    color: white;
                    text-shadow: 2px 2px 0px var(--vintage-dark);
                }

                .game-badge {
                    position: absolute;
                    top: 1rem;
                    right: 1rem;
                }

                .badge {
                    padding: 0.5rem 1rem;
                    border-radius: 0;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                    font-size: 0.8rem;
                }

                .badge.official {
                    background: var(--vintage-orange);
                    color: white;
                    border: 2px solid var(--vintage-dark);
                }

                .badge.custom {
                    background: var(--vintage-blue);
                    color: white;
                    border: 2px solid var(--vintage-dark);
                }

                .game-content {
                    padding: 1.5rem;
                }

                .game-title {
                    font-size: 1.5rem;
                    color: var(--vintage-dark);
                    margin-bottom: 1rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .game-description {
                    color: var(--vintage-brown);
                    margin-bottom: 1rem;
                    line-height: 1.5;
                }

                .game-rules {
                    margin-bottom: 1.5rem;
                }

                .game-rules h4 {
                    color: var(--vintage-dark);
                    margin-bottom: 0.5rem;
                    font-size: 1rem;
                    text-transform: uppercase;
                }

                .game-rules p {
                    color: var(--vintage-brown);
                    font-size: 0.9rem;
                    line-height: 1.4;
                }

                .game-stats {
                    display: grid;
                    grid-template-columns: 1fr;
                    gap: 0.5rem;
                    margin-bottom: 1.5rem;
                }

                .stat {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    color: var(--vintage-brown);
                    font-size: 0.9rem;
                }

                .stat .icon {
                    font-size: 1rem;
                }

                .game-actions {
                    display: flex;
                    gap: 1rem;
                }

                .btn-small {
                    padding: 0.5rem 1rem;
                    font-size: 0.9rem;
                }

                /* Modal */
                .game-modal {
                    display: none;
                    position: fixed;
                    z-index: 10000;
                    left: 0;
                    top: 0;
                    width: 100%;
                    height: 100%;
                    background-color: rgba(0,0,0,0.8);
                }

                .modal-content {
                    background-color: white;
                    margin: 5% auto;
                    padding: 0;
                    border: 3px solid var(--vintage-dark);
                    width: 90%;
                    max-width: 800px;
                    max-height: 80vh;
                    overflow-y: auto;
                    box-shadow: 10px 10px 0px var(--vintage-dark);
                }

                .modal-close {
                    color: var(--vintage-dark);
                    float: right;
                    font-size: 2rem;
                    font-weight: bold;
                    cursor: pointer;
                    padding: 1rem;
                }

                .modal-close:hover {
                    color: var(--vintage-orange);
                }

                .modal-header {
                    background: var(--vintage-orange);
                    color: white;
                    padding: 1rem 2rem;
                    border-bottom: 3px solid var(--vintage-dark);
                }

                .modal-header h2 {
                    margin: 0;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .modal-body {
                    padding: 2rem;
                }

                .modal-footer {
                    padding: 1rem 2rem;
                    background: var(--vintage-light);
                    border-top: 3px solid var(--vintage-dark);
                    display: flex;
                    gap: 1rem;
                    justify-content: flex-end;
                }

                /* Responsive */
                @media (max-width: 768px) {
                    .games-grid {
                        grid-template-columns: 1fr;
                        padding: 1rem;
                    }

                    .games-filters {
                        flex-direction: column;
                        align-items: center;
                    }

                    .filter-select {
                        min-width: 250px;
                    }

                    .game-actions {
                        flex-direction: column;
                    }

                    .modal-content {
                        width: 95%;
                        margin: 10% auto;
                    }
                }

                /* Styles pour les pages de jeux */
                .game-hero-section {
                    background: linear-gradient(135deg, var(--vintage-orange), var(--vintage-blue));
                    color: white;
                    padding: 4rem 0;
                }

                .game-hero-content {
                    display: grid;
                    grid-template-columns: 2fr 1fr;
                    gap: 3rem;
                    align-items: center;
                }

                .game-title {
                    font-size: 3rem;
                    font-weight: 900;
                    margin-bottom: 1rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .game-subtitle {
                    font-size: 1.3rem;
                    margin-bottom: 2rem;
                    opacity: 0.9;
                }

                .game-badges {
                    display: flex;
                    gap: 1rem;
                    margin-bottom: 2rem;
                    flex-wrap: wrap;
                }

                .badge.type {
                    background: var(--vintage-blue);
                    color: white;
                    border: 2px solid var(--vintage-dark);
                }

                .game-actions {
                    display: flex;
                    gap: 1rem;
                    flex-wrap: wrap;
                }

                .game-hero-image {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                }

                .game-placeholder-large {
                    font-size: 8rem;
                    text-shadow: 3px 3px 0px var(--vintage-dark);
                }

                /* Statistiques du jeu */
                .game-stats-section {
                    padding: 4rem 0;
                    background: var(--vintage-light);
                }

                .stats-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                    gap: 2rem;
                }

                .stat-card {
                    background: white;
                    padding: 2rem;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    text-align: center;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                    transition: all 0.3s ease;
                }

                .stat-card:hover {
                    transform: translate(-3px, -3px);
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }

                .stat-icon {
                    font-size: 3rem;
                    margin-bottom: 1rem;
                }

                .stat-content h3 {
                    font-size: 2.5rem;
                    color: var(--vintage-orange);
                    margin-bottom: 0.5rem;
                }

                .stat-content p {
                    color: var(--vintage-brown);
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                /* Informations du jeu */
                .game-info-section {
                    padding: 4rem 0;
                    background: var(--vintage-cream);
                }

                .game-info-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
                    gap: 2rem;
                }

                .info-card {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                }

                .card-title {
                    background: var(--vintage-orange);
                    color: white;
                    padding: 1rem 2rem;
                    margin: 0;
                    font-size: 1.3rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .card-content {
                    padding: 2rem;
                }

                .info-list {
                    display: flex;
                    flex-direction: column;
                    gap: 1rem;
                }

                .info-item {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    padding: 0.5rem 0;
                    border-bottom: 1px solid var(--vintage-light);
                }

                .info-item:last-child {
                    border-bottom: none;
                }

                .info-item .icon {
                    font-size: 1.2rem;
                    color: var(--vintage-orange);
                }

                /* Positions du jeu */
                .game-positions-section {
                    padding: 4rem 0;
                    background: var(--vintage-light);
                }

                .positions-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                    gap: 2rem;
                }

                .position-card {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                    transition: all 0.3s ease;
                }

                .position-card:hover {
                    transform: translate(-3px, -3px);
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }

                .position-header {
                    background: var(--vintage-blue);
                    color: white;
                    padding: 1rem 1.5rem;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }

                .position-header h3 {
                    margin: 0;
                    font-size: 1.2rem;
                }

                .badge.final {
                    background: var(--vintage-orange);
                    color: white;
                    padding: 0.3rem 0.8rem;
                    font-size: 0.8rem;
                    border-radius: 0;
                }

                .position-content {
                    padding: 1.5rem;
                }

                .position-content h4 {
                    color: var(--vintage-dark);
                    margin-bottom: 0.5rem;
                }

                .position-details {
                    display: flex;
                    gap: 1rem;
                    margin-top: 1rem;
                    flex-wrap: wrap;
                }

                .position-points {
                    color: var(--vintage-orange);
                    font-weight: bold;
                }

                .position-coordinates {
                    color: var(--vintage-brown);
                    font-size: 0.9rem;
                }

                /* Sessions récentes */
                .game-sessions-section {
                    padding: 4rem 0;
                    background: var(--vintage-cream);
                }

                .sessions-list {
                    display: flex;
                    flex-direction: column;
                    gap: 1.5rem;
                }

                .session-card {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                }

                .session-header {
                    background: var(--vintage-blue);
                    color: white;
                    padding: 1rem 1.5rem;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                }

                .session-header h3 {
                    margin: 0;
                }

                .session-status {
                    padding: 0.3rem 0.8rem;
                    border-radius: 0;
                    font-size: 0.8rem;
                    font-weight: bold;
                    text-transform: uppercase;
                }

                .status-active {
                    background: var(--vintage-orange);
                    color: white;
                }

                .status-completed {
                    background: var(--vintage-green);
                    color: white;
                }

                .status-paused {
                    background: var(--vintage-yellow);
                    color: var(--vintage-dark);
                }

                .session-info {
                    padding: 1.5rem;
                }

                .session-details {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                    gap: 1rem;
                    margin-bottom: 1rem;
                }

                .detail {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                    color: var(--vintage-brown);
                }

                .detail .icon {
                    color: var(--vintage-orange);
                }

                .session-notes {
                    background: var(--vintage-light);
                    padding: 1rem;
                    border-radius: 0;
                    border: 2px solid var(--vintage-dark);
                }

                .session-notes h4 {
                    margin: 0 0 0.5rem 0;
                    color: var(--vintage-dark);
                }

                /* Statistiques détaillées */
                .game-detailed-stats-section {
                    padding: 4rem 0;
                    background: var(--vintage-light);
                }

                .stats-table-container {
                    overflow-x: auto;
                    border: 3px solid var(--vintage-dark);
                    background: white;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                }

                .stats-table {
                    width: 100%;
                    border-collapse: collapse;
                }

                .stats-table th,
                .stats-table td {
                    padding: 1rem;
                    text-align: left;
                    border-bottom: 1px solid var(--vintage-light);
                }

                .stats-table th {
                    background: var(--vintage-orange);
                    color: white;
                    font-weight: bold;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .stats-table tr:hover {
                    background: var(--vintage-light);
                }

                /* Navigation */
                .game-navigation {
                    padding: 2rem 0;
                    background: var(--vintage-dark);
                }

                .nav-buttons {
                    display: flex;
                    gap: 1rem;
                    justify-content: center;
                    flex-wrap: wrap;
                }

                /* Page de jeu */
                .game-play-hero {
                    background: linear-gradient(135deg, var(--vintage-blue), var(--vintage-orange));
                    color: white;
                    padding: 3rem 0;
                }

                .game-play-header {
                    text-align: center;
                }

                .game-setup-section {
                    padding: 4rem 0;
                    background: var(--vintage-cream);
                }

                .setup-card {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                    max-width: 800px;
                    margin: 0 auto;
                }

                .setup-card .card-title {
                    background: var(--vintage-blue);
                    color: white;
                    padding: 1.5rem 2rem;
                    margin: 0;
                    font-size: 1.5rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .game-setup-form {
                    padding: 2rem;
                }

                .form-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                    gap: 1.5rem;
                    margin-bottom: 2rem;
                }

                .form-group {
                    display: flex;
                    flex-direction: column;
                    gap: 0.5rem;
                }

                .form-group label {
                    font-weight: bold;
                    color: var(--vintage-dark);
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .form-input,
                .form-select {
                    padding: 0.75rem 1rem;
                    border: 2px solid var(--vintage-dark);
                    background: white;
                    font-size: 1rem;
                    transition: all 0.3s ease;
                }

                .form-input:focus,
                .form-select:focus {
                    outline: none;
                    border-color: var(--vintage-orange);
                    box-shadow: 0 0 0 3px rgba(255, 107, 53, 0.2);
                }

                .participants-section {
                    margin: 2rem 0;
                    padding: 1.5rem;
                    background: var(--vintage-light);
                    border: 2px solid var(--vintage-dark);
                }

                .participants-section h3 {
                    margin: 0 0 1rem 0;
                    color: var(--vintage-dark);
                }

                .participants-list {
                    display: flex;
                    flex-direction: column;
                    gap: 1rem;
                    margin-bottom: 1rem;
                }

                .participant-item {
                    display: flex;
                    gap: 1rem;
                    align-items: center;
                    padding: 1rem;
                    background: white;
                    border: 2px solid var(--vintage-dark);
                }

                .participant-item input {
                    flex: 1;
                    padding: 0.5rem;
                    border: 1px solid var(--vintage-brown);
                }

                .participant-item button {
                    padding: 0.5rem 1rem;
                    background: var(--vintage-red);
                    color: white;
                    border: none;
                    cursor: pointer;
                }

                .form-actions {
                    display: flex;
                    gap: 1rem;
                    justify-content: center;
                    flex-wrap: wrap;
                }

                /* Zone de jeu */
                .game-zone {
                    padding: 2rem 0;
                    background: var(--vintage-light);
                }

                .game-interface {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }

                .game-header {
                    background: var(--vintage-orange);
                    color: white;
                    padding: 1.5rem 2rem;
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    flex-wrap: wrap;
                    gap: 1rem;
                }

                .game-info h2 {
                    margin: 0 0 0.5rem 0;
                }

                .game-timer {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .timer-display {
                    font-size: 1.5rem;
                    font-weight: bold;
                    font-family: monospace;
                }

                .game-controls {
                    display: flex;
                    gap: 1rem;
                }

                .active-participants {
                    padding: 2rem;
                    border-bottom: 2px solid var(--vintage-light);
                }

                .active-participants h3 {
                    margin: 0 0 1rem 0;
                    color: var(--vintage-dark);
                }

                .participants-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                    gap: 1rem;
                }

                .participant-display {
                    background: var(--vintage-light);
                    padding: 1rem;
                    border: 2px solid var(--vintage-dark);
                    text-align: center;
                }

                .game-positions {
                    padding: 2rem;
                    border-bottom: 2px solid var(--vintage-light);
                }

                .game-positions h3 {
                    margin: 0 0 1rem 0;
                    color: var(--vintage-dark);
                }

                .positions-display {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                    gap: 1rem;
                }

                .position-item {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    padding: 1rem;
                    background: var(--vintage-light);
                    border: 2px solid var(--vintage-dark);
                }

                .position-info h4 {
                    margin: 0 0 0.5rem 0;
                    color: var(--vintage-dark);
                }

                .position-info p {
                    margin: 0;
                    color: var(--vintage-brown);
                }

                .position-actions {
                    display: flex;
                    gap: 0.5rem;
                }

                .btn-small {
                    padding: 0.5rem 1rem;
                    font-size: 0.9rem;
                }

                .game-notes {
                    padding: 2rem;
                }

                .game-notes h3 {
                    margin: 0 0 1rem 0;
                    color: var(--vintage-dark);
                }

                .game-notes textarea {
                    width: 100%;
                    padding: 1rem;
                    border: 2px solid var(--vintage-dark);
                    background: white;
                    font-family: inherit;
                    resize: vertical;
                }

                /* Page des règles */
                .rules-hero-section {
                    background: linear-gradient(135deg, var(--vintage-blue), var(--vintage-orange));
                    color: white;
                    padding: 4rem 0;
                    text-align: center;
                }

                .rules-title {
                    font-size: 3rem;
                    font-weight: 900;
                    margin-bottom: 1rem;
                    text-transform: uppercase;
                    letter-spacing: 0.1em;
                }

                .rules-subtitle {
                    font-size: 1.3rem;
                    opacity: 0.9;
                }

                .rules-content-section {
                    padding: 4rem 0;
                    background: var(--vintage-cream);
                }

                .rules-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
                    gap: 2rem;
                    margin-bottom: 3rem;
                }

                .rules-card {
                    background: white;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    overflow: hidden;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                }

                .rules-text {
                    line-height: 1.6;
                    color: var(--vintage-brown);
                }

                .info-content {
                    display: flex;
                    flex-direction: column;
                    gap: 0.2rem;
                }

                .info-content strong {
                    color: var(--vintage-dark);
                }

                .positions-section {
                    margin: 3rem 0;
                }

                .positions-timeline {
                    display: flex;
                    flex-direction: column;
                    gap: 2rem;
                }

                .position-step {
                    display: flex;
                    gap: 2rem;
                    align-items: flex-start;
                }

                .position-number {
                    background: var(--vintage-orange);
                    color: white;
                    width: 60px;
                    height: 60px;
                    border-radius: 50%;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 1.5rem;
                    font-weight: bold;
                    flex-shrink: 0;
                }

                .position-content {
                    flex: 1;
                    background: white;
                    padding: 1.5rem;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                }

                .position-content h3 {
                    margin: 0 0 0.5rem 0;
                    color: var(--vintage-dark);
                }

                .position-content p {
                    margin: 0 0 1rem 0;
                    color: var(--vintage-brown);
                }

                .position-details {
                    display: flex;
                    gap: 1rem;
                    flex-wrap: wrap;
                }

                .position-badge {
                    padding: 0.3rem 0.8rem;
                    border-radius: 0;
                    font-size: 0.8rem;
                    font-weight: bold;
                    text-transform: uppercase;
                }

                .position-badge.final {
                    background: var(--vintage-orange);
                    color: white;
                }

                .tips-section {
                    margin: 3rem 0;
                }

                .tips-grid {
                    display: grid;
                    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                    gap: 2rem;
                }

                .tip-card {
                    background: white;
                    padding: 2rem;
                    border: 3px solid var(--vintage-dark);
                    border-radius: 0;
                    text-align: center;
                    box-shadow: 5px 5px 0px var(--vintage-dark);
                    transition: all 0.3s ease;
                }

                .tip-card:hover {
                    transform: translate(-3px, -3px);
                    box-shadow: 8px 8px 0px var(--vintage-dark);
                }

                .tip-icon {
                    font-size: 3rem;
                    margin-bottom: 1rem;
                }

                .tip-card h3 {
                    color: var(--vintage-dark);
                    margin-bottom: 1rem;
                }

                .tip-card p {
                    color: var(--vintage-brown);
                    line-height: 1.5;
                }

                .rules-actions {
                    margin-top: 3rem;
                    padding: 2rem 0;
                    background: var(--vintage-dark);
                }

                .action-buttons {
                    display: flex;
                    gap: 1rem;
                    justify-content: center;
                    flex-wrap: wrap;
                }

                /* Responsive pour les pages de jeux */
                @media (max-width: 768px) {
                    .game-hero-content {
                        grid-template-columns: 1fr;
                        text-align: center;
                    }

                    .game-title {
                        font-size: 2.5rem;
                    }

                    .stats-grid {
                        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                    }

                    .game-info-grid {
                        grid-template-columns: 1fr;
                    }

                    .positions-grid {
                        grid-template-columns: 1fr;
                    }

                    .form-grid {
                        grid-template-columns: 1fr;
                    }

                    .game-header {
                        flex-direction: column;
                        text-align: center;
                    }

                    .position-step {
                        flex-direction: column;
                        text-align: center;
                    }

                    .position-number {
                        align-self: center;
                    }

                    .tips-grid {
                        grid-template-columns: 1fr;
                    }
                }
            </style>
        {% endif %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="{{ asset('js/responsive.js') }}" defer></script>
        {% endblock %}
    </head>
    <body{% if block('body_class') is defined %} class="{{ block('body_class') }}"{% endif %}>
        <!-- Flash Messages -->
        {% include 'components/flash_messages.html.twig' %}
        
        <!-- Header Component -->
        {% include 'components/header.html.twig' %}

        <!-- Main Content -->
        <main>
            {% block body %}{% endblock %}
        </main>

        <!-- Footer Component -->
        {% include 'components/footer.html.twig' %}
    </body>
</html>
