{% extends 'base.html.twig' %}

{% block title %}Connexion - Switch Game{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-header">
            <div class="auth-logo">🏀</div>
            <h1 class="auth-title">Connexion</h1>
            <p class="auth-subtitle">Accédez à votre compte Switch Game</p>
        </div>
        
        {% if error is defined and error %}
            <div class="alert alert-error">
                {{ error.messageKey|trans(error.messageData, 'security') }}
            </div>
        {% endif %}

        <form method="post" class="auth-form">
            <div class="form-group">
                <label for="inputEmail" class="form-label">Email</label>
                <input type="email" 
                       value="{{ last_username is defined ? last_username : '' }}" 
                       name="_username" 
                       id="inputEmail" 
                       class="form-control" 
                       autocomplete="email" 
                       required 
                       autofocus>
            </div>
            
            <div class="form-group">
                <label for="inputPassword" class="form-label">Mot de passe</label>
                <input type="password" 
                       name="_password" 
                       id="inputPassword" 
                       class="form-control" 
                       autocomplete="current-password" 
                       required>
            </div>

            <div class="auth-actions">
                <button class="auth-submit" type="submit">
                    Se connecter
                </button>
            </div>
        </form>

        <div class="auth-links">
            <p>Pas encore de compte ? <a href="{{ path('app_register') }}">Créer un compte</a></p>
        </div>
    </div>
</div>
{% endblock %}
