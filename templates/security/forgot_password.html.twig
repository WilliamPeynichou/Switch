{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié - Switch Game{% endblock %}

{% block body %}
<div class="game-history-page">
    <!-- Hero Section -->
    <div class="history-header">
        <h1>🔐 Mot de passe oublié</h1>
        <p>Entrez votre adresse email pour recevoir un lien de réinitialisation</p>
    </div>

    <!-- Forgot Password Form -->
    <div class="stats-section">
        <h2>📧 Réinitialisation</h2>
        
        <form method="POST" class="forgot-password-form">
            <div class="input-group">
                <label for="email">Adresse email *</label>
                <input type="email" name="email" id="email" class="form-control" required
                       placeholder="votre@email.com">
            </div>

            <div class="history-actions">
                <button type="submit" class="btn btn-primary">
                    📤 Envoyer le lien de réinitialisation
                </button>
                <a href="{{ path('app_login') }}" class="btn btn-secondary">
                    ↩️ Retour à la connexion
                </a>
            </div>
        </form>
    </div>

    <!-- Help Info -->
    <div class="history-section">
        <h2>❓ Besoin d'aide ?</h2>
        
        <div class="rules-grid">
            <div class="rule-card">
                <h3>📧 Vérifiez votre boîte email</h3>
                <p>Le lien de réinitialisation sera envoyé à votre adresse email</p>
            </div>
            
            <div class="rule-card">
                <h3>⏰ Lien valide 1 heure</h3>
                <p>Le lien expire après 1 heure pour votre sécurité</p>
            </div>
            
            <div class="rule-card">
                <h3>🔒 Sécurité</h3>
                <p>Votre mot de passe actuel reste valide jusqu'à la réinitialisation</p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
