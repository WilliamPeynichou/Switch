{% extends 'base.html.twig' %}

{% block title %}Connexion - Switch Game{% endblock %}

{% block body_class %}auth-page{% endblock %}

{% block body %}
<div class="auth-page">
    <div class="auth-container">
        <div class="auth-header">
            <h1 class="auth-logo">🔐 Connexion</h1>
            <p class="auth-subtitle">Connectez-vous à votre compte Switch Game</p>
        </div>

        <div class="auth-body">
            <form method="post" class="auth-form">
                {% if error is defined and error %}
                    <div class="auth-alert auth-alert-danger">
                        <i class="icon">⚠️</i>
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <div class="auth-form-group">
                    <label for="inputEmail" class="auth-label">Email</label>
                    <input type="email" value="{{ last_username ?? '' }}" name="email" id="inputEmail" 
                           class="auth-input" autocomplete="email" required autofocus
                           placeholder="votre@email.com">
                </div>

                <div class="auth-form-group">
                    <label for="inputPassword" class="auth-label">Mot de passe</label>
                    <input type="password" name="password" id="inputPassword" 
                           class="auth-input" autocomplete="current-password" required
                           placeholder="Votre mot de passe">
                </div>

                <div class="auth-checkbox-group">
                    <input type="checkbox" name="_remember_me" id="remember_me" class="auth-checkbox">
                    <label for="remember_me" class="auth-checkbox-label">
                        Se souvenir de moi
                    </label>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button type="submit" class="auth-btn auth-btn-primary">
                    <i class="icon">🚀</i>
                    Se connecter
                </button>
            </form>

            <div class="auth-links">
                <p>Pas encore de compte ? <a href="{{ path('app_register') }}" class="auth-link">Créer un compte</a></p>
            </div>
        </div>
    </div>
</div>
{% endblock %}
