{% extends 'base.html.twig' %}

{% block title %}{{ game.name }} - Switch Game{% endblock %}

{% block body %}
<div class="game-hero">
    <div class="container">
        <div class="hero-content">
            <h1 class="game-title">
                <span class="title-icon">🏀</span>
                {{ game.name }}
            </h1>
            <p class="game-subtitle">{{ game.description ?? 'Jeu de basket passionnant' }}</p>
        </div>
    </div>
</div>

<div class="game-content">
    <div class="container">
        {% if message is defined %}
            <div class="development-notice">
                <div class="notice-card">
                    <h2>🚧 Page en cours de développement</h2>
                    <p>{{ message }}</p>
                    <p>Cette page sera bientôt disponible avec toutes les fonctionnalités du jeu !</p>
                    <a href="{{ path('app_home') }}" class="btn btn-primary">
                        <i class="icon">🏠</i>
                        Retour à l'accueil
                    </a>
                </div>
            </div>
        {% else %}
            <div class="game-info">
                <h2>Informations du jeu</h2>
                <div class="info-grid">
                    <div class="info-card">
                        <h3>Description</h3>
                        <p>{{ game.description ?? 'Aucune description disponible' }}</p>
                    </div>
                    
                    <div class="info-card">
                        <h3>Type de jeu</h3>
                        <p>{{ game.gameType ?? 'Non spécifié' }}</p>
                    </div>
                    
                    <div class="info-card">
                        <h3>Nombre de joueurs</h3>
                        <p>{{ game.minPlayers ?? 1 }} - {{ game.maxPlayers ?? 10 }} joueurs</p>
                    </div>
                    
                    <div class="info-card">
                        <h3>Durée moyenne</h3>
                        <p>{{ game.defaultDurationMinutes ?? 30 }} minutes</p>
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>
{% endblock %}