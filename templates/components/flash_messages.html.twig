{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="flash-message flash-{{ type }}" role="alert">
            <div class="flash-content">
                <div class="flash-icon">
                    {% if type == 'success' %}
                        ✅
                    {% elseif type == 'error' %}
                        ❌
                    {% elseif type == 'warning' %}
                        ⚠️
                    {% elseif type == 'info' %}
                        ℹ️
                    {% else %}
                        📢
                    {% endif %}
                </div>
                <div class="flash-text">
                    {{ message }}
                </div>
                <button class="flash-close" onclick="this.parentElement.parentElement.remove()">
                    <span>&times;</span>
                </button>
            </div>
        </div>
    {% endfor %}
{% endfor %}

<style>
.flash-message {
    position: fixed;
    top: var(--space-lg);
    right: var(--space-lg);
    background: white;
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-xl);
    padding: 0;
    max-width: 400px;
    z-index: 3000;
    transform: translateX(100%);
    transition: transform var(--transition-normal);
    border-left: 4px solid;
    animation: slideInRight 0.5s ease-out forwards;
}

.flash-success {
    border-left-color: #10b981;
}

.flash-error {
    border-left-color: #ef4444;
}

.flash-warning {
    border-left-color: #f59e0b;
}

.flash-info {
    border-left-color: #3b82f6;
}

.flash-content {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    padding: var(--space-lg);
}

.flash-icon {
    font-size: var(--text-xl);
    flex-shrink: 0;
}

.flash-text {
    flex: 1;
    color: var(--vintage-blue);
    font-weight: 500;
    line-height: 1.5;
}

.flash-close {
    background: none;
    border: none;
    font-size: var(--text-xl);
    cursor: pointer;
    color: var(--vintage-gray);
    padding: var(--space-xs);
    border-radius: var(--radius-sm);
    transition: var(--transition-fast);
    flex-shrink: 0;
}

.flash-close:hover {
    background: #f8f9fa;
    color: var(--vintage-blue);
}

@keyframes slideInRight {
    from {
        transform: translateX(100%);
    }
    to {
        transform: translateX(0);
    }
}

/* Auto-hide after 5 seconds */
.flash-message {
    animation: slideInRight 0.5s ease-out forwards, fadeOut 0.5s ease-out 4.5s forwards;
}

@keyframes fadeOut {
    from {
        opacity: 1;
        transform: translateX(0);
    }
    to {
        opacity: 0;
        transform: translateX(100%);
    }
}

/* Responsive */
@media (max-width: 767px) {
    .flash-message {
        top: var(--space-sm);
        right: var(--space-sm);
        left: var(--space-sm);
        max-width: none;
    }
}
</style>
