{% extends 'base.html.twig' %}

{% block title %}Statistiques - Switch Game{% endblock %}

{% block body %}
<div class="statistics-hero">
    <div class="container">
        <h1 class="page-title">
            <span class="title-icon">📊</span>
            Statistiques
        </h1>
        <p class="page-subtitle">Analysez vos performances et comparez-vous aux autres joueurs</p>
    </div>
</div>

<div class="statistics-content">
    <div class="container">
        <!-- Statistiques globales -->
        <div class="stats-overview">
            <h2>Vue d'ensemble</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">🎮</div>
                    <div class="stat-content">
                        <h3>{{ totalGames }}</h3>
                        <p>Jeux disponibles</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">🏆</div>
                    <div class="stat-content">
                        <h3>{{ totalSessions }}</h3>
                        <p>Sessions jouées</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">👥</div>
                    <div class="stat-content">
                        <h3>{{ totalPlayers }}</h3>
                        <p>Joueurs actifs</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⭐</div>
                    <div class="stat-content">
                        <h3>{{ userStats|length }}</h3>
                        <p>Mes statistiques</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mes sessions récentes -->
        <div class="my-sessions">
            <h2>Mes sessions récentes</h2>
            {% if userSessions %}
                <div class="sessions-list">
                    {% for session in userSessions|slice(0, 5) %}
                    <div class="session-card">
                        <div class="session-info">
                            <h3>{{ session.sessionName }}</h3>
                            <p class="session-game">{{ session.game.name }}</p>
                            <p class="session-date">{{ session.createdAt|date('d/m/Y H:i') }}</p>
                        </div>
                        <div class="session-status">
                            <span class="status-badge status-{{ session.status }}">
                                {{ session.status|title }}
                            </span>
                        </div>
                        <div class="session-actions">
                            <a href="{{ path('app_session_show', {id: session.id}) }}" class="btn btn-sm btn-primary">
                                Voir détails
                            </a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="text-center">
                    <a href="{{ path('app_statistics_my_sessions') }}" class="btn btn-secondary">
                        Voir toutes mes sessions
                    </a>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">🎮</div>
                    <h3>Aucune session</h3>
                    <p>Commencez à jouer pour voir vos statistiques !</p>
                    <a href="{{ path('app_home') }}" class="btn btn-primary">Découvrir les jeux</a>
                </div>
            {% endif %}
        </div>

        <!-- Statistiques par jeu -->
        <div class="game-stats">
            <h2>Statistiques par jeu</h2>
            <div class="game-stats-grid">
                {% for gameId, stats in gameStats %}
                <div class="game-stat-card">
                    <div class="game-stat-header">
                        <h3>{{ stats.game.name }}</h3>
                        <span class="game-type">{{ stats.game.gameType|replace({'_': ' '})|title }}</span>
                    </div>
                    <div class="game-stat-content">
                        <div class="stat-item">
                            <span class="stat-label">Sessions</span>
                            <span class="stat-value">{{ stats.sessionsCount }}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Score moyen</span>
                            <span class="stat-value">{{ stats.avgScore|number_format(1) }}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Meilleur score</span>
                            <span class="stat-value">{{ stats.bestScore }}</span>
                        </div>
                    </div>
                    <div class="game-stat-actions">
                        <a href="{{ path('app_statistics_by_game', {id: gameId}) }}" class="btn btn-sm btn-outline">
                            Voir détails
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Top joueurs -->
        <div class="leaderboard-preview">
            <h2>Classement</h2>
            <div class="leaderboard-content">
                <div class="leaderboard-section">
                    <h3>🏆 Meilleurs scores</h3>
                    <div class="leaderboard-list">
                        {% for stat in topPlayers|slice(0, 5) %}
                        <div class="leaderboard-item">
                            <span class="rank">{{ loop.index }}</span>
                            <span class="player">{{ stat.player.playerName }}</span>
                            <span class="score">{{ stat.totalPoints }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="leaderboard-section">
                    <h3>⚡ Plus actifs</h3>
                    <div class="leaderboard-list">
                        {% for stat in mostActivePlayers|slice(0, 5) %}
                        <div class="leaderboard-item">
                            <span class="rank">{{ loop.index }}</span>
                            <span class="player">{{ stat.player.playerName }}</span>
                            <span class="score">{{ stat.sessionCount }} sessions</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="text-center">
                <a href="{{ path('app_statistics_leaderboard') }}" class="btn btn-primary">
                    Voir le classement complet
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}