{% extends 'base.html.twig' %}

{% block title %}Tour du Monde - Switch Game{% endblock %}

{% block body %}
<div class="tour-du-monde-hero">
    <div class="container">
        <div class="hero-content">
            <h1 class="game-title">
                <span class="title-icon">🌍</span>
                Tour du Monde
            </h1>
            <p class="game-subtitle">Le jeu de basket le plus épique ! Parcourez le monde des positions et affrontez-vous en 1 contre 1 !</p>
        </div>
    </div>
</div>

<!-- Règles du jeu -->
<div class="game-rules-section">
    <div class="container">
        <h2 class="section-title">
            <span class="title-icon">📋</span>
            Règles du Tour du Monde
        </h2>
        
        <div class="rules-content">
            <div class="rules-grid">
                <div class="rule-card">
                    <div class="rule-icon">🎯</div>
                    <h3>Objectif</h3>
                    <p>Parcourez toutes les positions du terrain en marquant des paniers. Le premier à atteindre la position finale affronte un adversaire en 1 contre 1 !</p>
                </div>
                
                <div class="rule-card">
                    <div class="rule-icon">📍</div>
                    <h3>Positions</h3>
                    <p>Commencez à la position 1 et progressez position par position. Chaque position doit être validée par un panier réussi.</p>
                </div>
                
                <div class="rule-card">
                    <div class="rule-icon">⚡</div>
                    <h3>Pénalités</h3>
                    <p><strong>Airball :</strong> -2 positions<br><strong>Brique :</strong> -1 position<br>Attention à ne pas reculer trop !</p>
                </div>
                
                <div class="rule-card">
                    <div class="rule-icon">🏆</div>
                    <h3>Finale</h3>
                    <p>Le premier à atteindre la position finale affronte un adversaire choisi aléatoirement dans la roue de la fortune !</p>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Configuration du jeu -->
<div class="game-setup-section">
    <div class="container">
        <h2 class="section-title">
            <span class="title-icon">⚙️</span>
            Configuration de la Partie
        </h2>
        
        <div class="setup-card">
            <form id="game-setup-form" method="POST" action="{{ path('app_tour_du_monde_setup') }}">
                <div class="form-grid">
                    <!-- Nom de la session -->
                    <div class="form-group">
                        <label for="sessionName">Nom de la session :</label>
                        <input type="text" id="sessionName" name="sessionName" 
                               value="Tour du Monde - {{ 'now'|date('d/m/Y H:i') }}" 
                               class="form-input" required>
                    </div>
                    
                    <!-- Difficulté -->
                    <div class="form-group">
                        <label for="difficulty">Difficulté :</label>
                        <select id="difficulty" name="difficulty" class="form-select" required>
                            <option value="">Sélectionner une difficulté</option>
                            {% for difficulty in difficulties %}
                                <option value="{{ difficulty.id }}">{{ difficulty.name }} - {{ difficulty.description }}</option>
                            {% endfor %}
                        </select>
                    </div>
                </div>
                
                <!-- Participants -->
                <div class="participants-section">
                    <h3>Participants</h3>
                    <p class="participants-help">Ajoutez au moins 2 participants pour commencer le jeu</p>
                    
                    <div id="participants-list" class="participants-list">
                        <div class="participant-item">
                            <input type="text" name="participants[]" placeholder="Nom du joueur 1" class="participant-input" required>
                            <button type="button" class="btn-remove-participant" style="display: none;">❌</button>
                        </div>
                        <div class="participant-item">
                            <input type="text" name="participants[]" placeholder="Nom du joueur 2" class="participant-input" required>
                            <button type="button" class="btn-remove-participant" style="display: none;">❌</button>
                        </div>
                    </div>
                    
                    <button type="button" id="add-participant" class="btn btn-secondary">
                        <i class="icon">➕</i>
                        Ajouter un participant
                    </button>
                </div>
                
                <!-- Actions -->
                <div class="form-actions">
                    <button type="submit" id="start-game" class="btn btn-primary">
                        <i class="icon">🚀</i>
                        Commencer le Tour du Monde !
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Informations sur les positions -->
<div class="positions-info-section">
    <div class="container">
        <h2 class="section-title">
            <span class="title-icon">📍</span>
            Positions du Tour du Monde
        </h2>
        
        <div class="positions-timeline">
            <div class="position-step">
                <div class="position-number">1</div>
                <div class="position-content">
                    <h3>Départ - Côté gauche du panier (45°)</h3>
                    <p>Position de départ. Marquez un panier pour passer à la position suivante.</p>
                </div>
            </div>
            
            <div class="position-step">
                <div class="position-number">2</div>
                <div class="position-content">
                    <h3>Face panier (devant)</h3>
                    <p>Position centrale. Un des plus faciles du parcours.</p>
                </div>
            </div>
            
            <div class="position-step">
                <div class="position-number">3</div>
                <div class="position-content">
                    <h3>Côté droit du panier (45°)</h3>
                    <p>Symétrique de la position 1. Attention à l'angle !</p>
                </div>
            </div>
            
            <div class="position-step">
                <div class="position-number">4</div>
                <div class="position-content">
                    <h3>Ligne à 3 points</h3>
                    <p>La distance augmente ! Concentration maximale requise.</p>
                </div>
            </div>
            
            <div class="position-step">
                <div class="position-number">5</div>
                <div class="position-content">
                    <h3>Position finale</h3>
                    <p>🏆 <strong>FÉLICITATIONS !</strong> Vous avez terminé le tour du monde !<br>
                    La roue de la fortune va choisir votre adversaire pour le 1 contre 1 final !</p>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
