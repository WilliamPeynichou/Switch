{% extends 'base.html.twig' %}

{% block title %}Statistiques - Switch Game{% endblock %}

{% block body %}
<div class="statistics-hero">
    <div class="container">
        <h1 class="page-title">
            <span class="title-icon">📊</span>
            Statistiques
        </h1>
        <p class="page-subtitle">Analysez vos performances et comparez-vous aux autres joueurs</p>
    </div>
</div>

<div class="statistics-content">
    <div class="container">
        <!-- Statistiques globales -->
        <div class="stats-overview">
            <h2>Vue d'ensemble</h2>
            <div class="stats-grid">
                <div class="stat-card">
                    <div class="stat-icon">🎮</div>
                    <div class="stat-content">
                        <h3>{{ totalGames }}</h3>
                        <p>Jeux disponibles</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">🏆</div>
                    <div class="stat-content">
                        <h3>{{ totalSessions }}</h3>
                        <p>Sessions jouées</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">👥</div>
                    <div class="stat-content">
                        <h3>{{ totalPlayers }}</h3>
                        <p>Joueurs actifs</p>
                    </div>
                </div>
                <div class="stat-card">
                    <div class="stat-icon">⭐</div>
                    <div class="stat-content">
                        <h3>{{ userStats|length }}</h3>
                        <p>Mes statistiques</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Mes sessions récentes -->
        <div class="my-sessions">
            <h2>Mes sessions récentes</h2>
            {% if userSessions %}
                <div class="sessions-list">
                    {% for session in userSessions|slice(0, 5) %}
                    <div class="session-card">
                        <div class="session-info">
                            <h3>{{ session.sessionName }}</h3>
                            <p class="session-game">{{ session.game.name }}</p>
                            <p class="session-date">{{ session.createdAt|date('d/m/Y H:i') }}</p>
                        </div>
                        <div class="session-status">
                            <span class="status-badge status-{{ session.status }}">
                                {{ session.status|title }}
                            </span>
                        </div>
                        <div class="session-actions">
                            <a href="{{ path('app_session_show', {id: session.id}) }}" class="btn btn-sm btn-primary">
                                Voir détails
                            </a>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                <div class="text-center">
                    <a href="{{ path('app_statistics_my_sessions') }}" class="btn btn-secondary">
                        Voir toutes mes sessions
                    </a>
                </div>
            {% else %}
                <div class="empty-state">
                    <div class="empty-icon">🎮</div>
                    <h3>Aucune session</h3>
                    <p>Commencez à jouer pour voir vos statistiques !</p>
                    <a href="{{ path('app_home') }}" class="btn btn-primary">Découvrir les jeux</a>
                </div>
            {% endif %}
        </div>

        <!-- Statistiques par jeu -->
        <div class="game-stats">
            <h2>Statistiques par jeu</h2>
            <div class="game-stats-grid">
                {% for gameId, stats in gameStats %}
                <div class="game-stat-card">
                    <div class="game-stat-header">
                        <h3>{{ stats.game.name }}</h3>
                        <span class="game-type">{{ stats.game.gameType|replace({'_': ' '})|title }}</span>
                    </div>
                    <div class="game-stat-content">
                        <div class="stat-item">
                            <span class="stat-label">Sessions</span>
                            <span class="stat-value">{{ stats.sessionsCount }}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Score moyen</span>
                            <span class="stat-value">{{ stats.avgScore|number_format(1) }}</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-label">Meilleur score</span>
                            <span class="stat-value">{{ stats.bestScore }}</span>
                        </div>
                    </div>
                    <div class="game-stat-actions">
                        <a href="{{ path('app_statistics_by_game', {id: gameId}) }}" class="btn btn-sm btn-outline">
                            Voir détails
                        </a>
                    </div>
                </div>
                {% endfor %}
            </div>
        </div>

        <!-- Top joueurs -->
        <div class="leaderboard-preview">
            <h2>Classement</h2>
            <div class="leaderboard-content">
                <div class="leaderboard-section">
                    <h3>🏆 Meilleurs scores</h3>
                    <div class="leaderboard-list">
                        {% for stat in topPlayers|slice(0, 5) %}
                        <div class="leaderboard-item">
                            <span class="rank">{{ loop.index }}</span>
                            <span class="player">{{ stat.player.playerName }}</span>
                            <span class="score">{{ stat.totalPoints }}</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
                <div class="leaderboard-section">
                    <h3>⚡ Plus actifs</h3>
                    <div class="leaderboard-list">
                        {% for stat in mostActivePlayers|slice(0, 5) %}
                        <div class="leaderboard-item">
                            <span class="rank">{{ loop.index }}</span>
                            <span class="player">{{ stat.player.playerName }}</span>
                            <span class="score">{{ stat.sessionCount }} sessions</span>
                        </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="text-center">
                <a href="{{ path('app_statistics_leaderboard') }}" class="btn btn-primary">
                    Voir le classement complet
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block stylesheets %}
<style>
.statistics-hero {
    background: linear-gradient(135deg, var(--vintage-orange) 0%, #F7931E 100%);
    color: white;
    padding: 4rem 0;
    text-align: center;
}

.page-title {
    font-size: 3rem;
    font-weight: bold;
    margin: 0 0 1rem 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
}

.title-icon {
    font-size: 3.5rem;
}

.page-subtitle {
    font-size: 1.2rem;
    margin: 0;
    opacity: 0.9;
}

.statistics-content {
    padding: 4rem 0;
    background: #f8f9fa;
}

.stats-overview {
    margin-bottom: 4rem;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.stat-card {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    gap: 1rem;
    transition: transform 0.3s ease;
}

.stat-card:hover {
    transform: translateY(-5px);
}

.stat-icon {
    font-size: 3rem;
    color: var(--vintage-orange);
}

.stat-content h3 {
    font-size: 2.5rem;
    font-weight: bold;
    color: var(--vintage-orange);
    margin: 0;
}

.stat-content p {
    color: #666;
    margin: 0;
    font-size: 1.1rem;
}

.my-sessions, .game-stats, .leaderboard-preview {
    margin-bottom: 4rem;
}

.sessions-list {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
}

.session-card {
    background: white;
    padding: 1.5rem;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.1);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
}

.session-info h3 {
    margin: 0 0 0.5rem 0;
    color: var(--vintage-orange);
}

.session-game {
    color: #666;
    margin: 0 0 0.25rem 0;
    font-size: 0.9rem;
}

.session-date {
    color: #999;
    margin: 0;
    font-size: 0.8rem;
}

.status-badge {
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: bold;
    text-transform: uppercase;
}

.status-active { background: #d4edda; color: #155724; }
.status-paused { background: #fff3cd; color: #856404; }
.status-completed { background: #cce5ff; color: #004085; }

.game-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.game-stat-card {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
    transition: transform 0.3s ease;
}

.game-stat-card:hover {
    transform: translateY(-5px);
}

.game-stat-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
}

.game-stat-header h3 {
    margin: 0;
    color: var(--vintage-orange);
}

.game-type {
    background: #f8f9fa;
    padding: 0.25rem 0.75rem;
    border-radius: 20px;
    font-size: 0.8rem;
    color: #666;
}

.game-stat-content {
    margin-bottom: 1.5rem;
}

.stat-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0;
    border-bottom: 1px solid #f0f0f0;
}

.stat-item:last-child {
    border-bottom: none;
}

.stat-label {
    color: #666;
}

.stat-value {
    font-weight: bold;
    color: var(--vintage-orange);
}

.leaderboard-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 2rem;
    margin-top: 2rem;
}

.leaderboard-section {
    background: white;
    padding: 2rem;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.leaderboard-section h3 {
    margin: 0 0 1.5rem 0;
    color: var(--vintage-orange);
}

.leaderboard-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.leaderboard-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.75rem;
    background: #f8f9fa;
    border-radius: 10px;
}

.rank {
    background: var(--vintage-orange);
    color: white;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: bold;
    font-size: 0.9rem;
}

.player {
    flex: 1;
    font-weight: bold;
}

.score {
    color: var(--vintage-orange);
    font-weight: bold;
}

.empty-state {
    text-align: center;
    padding: 4rem 2rem;
    background: white;
    border-radius: 15px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.1);
}

.empty-icon {
    font-size: 4rem;
    margin-bottom: 1rem;
}

.empty-state h3 {
    color: var(--vintage-orange);
    margin-bottom: 1rem;
}

.empty-state p {
    color: #666;
    margin-bottom: 2rem;
}

/* Responsive */
@media (max-width: 768px) {
    .page-title {
        font-size: 2rem;
    }
    
    .stats-grid {
        grid-template-columns: 1fr;
    }
    
    .session-card {
        flex-direction: column;
        text-align: center;
    }
    
    .game-stats-grid {
        grid-template-columns: 1fr;
    }
    
    .leaderboard-content {
        grid-template-columns: 1fr;
    }
}
</style>
{% endblock %}
