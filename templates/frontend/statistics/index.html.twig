{% extends 'base.html.twig' %}

{% block title %}Statistiques - Switch Game{% endblock %}

{% block body %}
<div class="game-history-page">
    <!-- Hero Section -->
    <div class="history-header">
        <h1>📊 Mes Statistiques</h1>
        <p>Suivez vos performances et progressez dans vos jeux</p>
    </div>

    <!-- Stats Overview -->
    <div class="stats-section">
        <h2>📈 Vue d'ensemble</h2>
        
        <div class="rules-grid">
            <div class="rule-card">
                <h3>🎮 Parties Jouées</h3>
                <div class="detail-value">{{ totalSessions }}</div>
            </div>
            
            <div class="rule-card">
                <h3>🏆 Points Totaux</h3>
                <div class="detail-value">{{ totalPoints }}</div>
            </div>
            
            <div class="rule-card">
                <h3>📊 Score Moyen</h3>
                <div class="detail-value">{{ averageScore|number_format(1) }}</div>
            </div>
            
            <div class="rule-card">
                <h3>🎯 Jeux Actifs</h3>
                <div class="detail-value">{{ totalGames }}</div>
            </div>
        </div>
    </div>

    <!-- User Stats -->
    {% if userStats is not empty %}
    <div class="history-section">
        <h2>📋 Mes Performances</h2>
        
        <div class="history-list">
            {% for stat in userStats %}
            <div class="history-item">
                <div class="history-header">
                    <div class="history-title">
                        <h3>Partie #{{ loop.index }}</h3>
                    </div>
                    <div class="history-date">
                        {{ stat.createdAt|date('d/m/Y H:i') }}
                    </div>
                </div>
                
                <div class="history-details">
                    <div class="detail-item">
                        <span class="detail-label">Points:</span>
                        <span class="detail-value">{{ stat.totalPoints }}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Tirs tentés:</span>
                        <span class="detail-value">{{ stat.shotsAttempted }}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Tirs réussis:</span>
                        <span class="detail-value">{{ stat.shotsMade }}</span>
                    </div>
                    <div class="detail-item">
                        <span class="detail-label">Pourcentage:</span>
                        <span class="detail-value">{{ stat.successRate|number_format(1) }}%</span>
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% else %}
    <div class="history-section">
        <div class="empty-history">
            <div class="empty-icon">📊</div>
            <h3>Aucune statistique</h3>
            <p>Commencez à jouer pour voir vos statistiques ici !</p>
            <div class="auth-links">
                <a href="{{ path('app_tour_du_monde') }}" class="btn btn-primary">
                    🎮 Commencer à jouer
                </a>
            </div>
        </div>
    </div>
    {% endif %}

    <!-- Leaderboard -->
    {% if leaderboard is not empty %}
    <div class="history-section">
        <h2>🏆 Classement</h2>
        
        <div class="history-list">
            {% for player in leaderboard %}
            <div class="history-item">
                <div class="history-header">
                    <div class="history-title">
                        <h3>#{{ loop.index }} {{ player.username }}</h3>
                    </div>
                    <div class="winner-badge">
                        {{ player.totalPoints }} points
                    </div>
                </div>
            </div>
            {% endfor %}
        </div>
    </div>
    {% endif %}

    <!-- Actions -->
    <div class="history-actions">
        <a href="{{ path('app_tour_du_monde') }}" class="btn btn-primary">
            🎮 Nouvelle partie
        </a>
        <a href="{{ path('app_home') }}" class="btn btn-secondary">
            🏠 Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}