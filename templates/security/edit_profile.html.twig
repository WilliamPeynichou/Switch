{% extends 'base.html.twig' %}

{% block title %}Modifier le Profil - Switch Game{% endblock %}

{% block body %}
<div class="game-history-page">
    <!-- Hero Section -->
    <div class="history-header">
        <h1>✏️ Modifier le Profil</h1>
        <p>Mettez à jour vos informations personnelles</p>
    </div>

    <!-- Edit Form -->
    <div class="stats-section">
        <h2>📋 Informations Personnelles</h2>
        
        {{ form_start(form) }}
            <div class="input-group">
                <label for="{{ form.firstName.vars.id }}">Prénom</label>
                {{ form_widget(form.firstName, {'attr': {'class': 'form-control', 'placeholder': 'Votre prénom'}}) }}
                {{ form_errors(form.firstName) }}
            </div>

            <div class="input-group">
                <label for="{{ form.lastName.vars.id }}">Nom</label>
                {{ form_widget(form.lastName, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom'}}) }}
                {{ form_errors(form.lastName) }}
            </div>

            <div class="input-group">
                <label for="{{ form.username.vars.id }}">Nom d'utilisateur</label>
                {{ form_widget(form.username, {'attr': {'class': 'form-control', 'placeholder': 'Votre nom d\'utilisateur'}}) }}
                {{ form_errors(form.username) }}
            </div>

            <div class="input-group">
                <label for="{{ form.email.vars.id }}">Email</label>
                {{ form_widget(form.email, {'attr': {'class': 'form-control', 'placeholder': 'votre@email.com'}}) }}
                {{ form_errors(form.email) }}
            </div>
    </div>

    <div class="history-section">
        <h2>🔒 Sécurité</h2>
        
        <div class="input-group">
            <label for="{{ form.plainPassword.first.vars.id }}">Nouveau mot de passe</label>
            {{ form_widget(form.plainPassword.first, {'attr': {'class': 'form-control', 'placeholder': 'Nouveau mot de passe (optionnel)'}}) }}
            {{ form_errors(form.plainPassword.first) }}
        </div>
        
        <div class="input-group">
            <label for="{{ form.plainPassword.second.vars.id }}">Confirmer le mot de passe</label>
            {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmez le nouveau mot de passe'}}) }}
            {{ form_errors(form.plainPassword.second) }}
        </div>
        
        <div class="flash-message flash-info">
            <span class="flash-icon">💡</span>
            Laissez les champs de mot de passe vides si vous ne souhaitez pas le changer.
        </div>
    </div>

    <!-- Actions -->
    <div class="history-actions">
        <a href="{{ path('app_profile') }}" class="btn btn-secondary">
            ↩️ Annuler
        </a>
        <button type="submit" class="btn btn-primary">
            💾 Sauvegarder les modifications
        </button>
    </div>
    {{ form_end(form) }}
</div>
{% endblock %}